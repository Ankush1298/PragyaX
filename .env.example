# PragyaX environment reference. Copy to .env (repo root) only if you need to change defaults.
# Every value is optional: with no .env the demo runs on SQLite + Mock AI.
# Placeholders only. Never commit real keys.

# --- Backend (read by backend/app/config.py, which loads this file automatically) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SQLite file used in demo mode (default: <repo>/pragyax.db)
DATABASE_PATH=

# --- AI provider (read by ai/factory.py) ---
# mock (default, deterministic, offline) | openai | gemini
# openai/gemini are scaffolds that currently fall back to the mock provider (see ai/real_provider.py).
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Supabase (NOT wired yet; for Nagin's integration, see database/supabase_guide.md) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Frontend (shell env vars when running `npm run dev`, not read from this file) ---
# Where Vite proxies /api in dev (change if port 8000 is busy):
# VITE_BACKEND_URL=http://127.0.0.1:8000
# Call the API directly instead of via proxy (put in frontend/.env.local):
# VITE_API_URL=http://localhost:8000
